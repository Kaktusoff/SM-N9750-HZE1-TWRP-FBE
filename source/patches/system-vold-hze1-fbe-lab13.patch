+static bool Get_Synthetic_Password_HAT(const userid_t user_id,
+		const std::string& spblob_path, const std::string& gatekeeper_password,
+		std::string* token_hex) {
+	static constexpr char kSyntheticPasswordHandle[] = "0000000000000000";
+	std::string sp_handle;
+	if (!Get_Spblob_Data(spblob_path, kSyntheticPasswordHandle, ".handle",
+			"synthetic-password handle", &sp_handle) || sp_handle.empty()) {
+		printf("failed to read the per-user synthetic-password Gatekeeper handle\n");
+		return false;
+	}
+	if (gatekeeper_password.empty()) {
+		printf("synthetic-password Gatekeeper credential is empty\n");
+		return false;
+	}
+
+	auto gk_device = ::android::hardware::gatekeeper::V1_0::IGatekeeper::getService();
+	if (gk_device == nullptr) {
+		printf("failed to get Gatekeeper service for synthetic-password verification\n");
+		return false;
+	}
+
+	android::hardware::hidl_vec<uint8_t> handle_hidl;
+	handle_hidl.setToExternal(reinterpret_cast<uint8_t*>(&sp_handle[0]), sp_handle.size());
+	android::hardware::hidl_vec<uint8_t> password_hidl;
+	password_hidl.setToExternal(
+			reinterpret_cast<uint8_t*>(const_cast<char*>(gatekeeper_password.data())),
+			gatekeeper_password.size());
+
+	bool callback_called = false;
+	bool verified = false;
+	int32_t gatekeeper_status = -1;
+	std::string raw_hat;
+	auto hw_ret = gk_device->verify(
+			user_id, 0 /* challenge */, handle_hidl, password_hidl,
+			[&](const android::hardware::gatekeeper::V1_0::GatekeeperResponse& rsp) {
+				callback_called = true;
+				gatekeeper_status = static_cast<int32_t>(rsp.code);
+				if (rsp.code >= android::hardware::gatekeeper::V1_0::GatekeeperStatusCode::STATUS_OK &&
+						rsp.data.size() == sizeof(hw_auth_token_t)) {
+					raw_hat.assign(reinterpret_cast<const char*>(rsp.data.data()), rsp.data.size());
+					verified = true;
+				}
+			});
+	if (!hw_ret.isOk() || !callback_called) {
+		printf("synthetic-password Gatekeeper verification transaction failed\n");
+		return false;
+	}
+	if (!verified) {
+		printf("synthetic-password Gatekeeper verification failed, status %d, HAT length %zu\n",
+				gatekeeper_status, raw_hat.size());
+		return false;
+	}
+
+	// Both structures store the Secure User ID in native byte order.  Validate the SID
+	// relationship without logging the identifier itself.
+	constexpr size_t kPasswordHandleSidOffset = 1;
+	constexpr size_t kHatSidOffset = 1 + sizeof(uint64_t);
+	if (sp_handle.size() < kPasswordHandleSidOffset + sizeof(uint64_t) ||
+			memcmp(sp_handle.data() + kPasswordHandleSidOffset,
+				   raw_hat.data() + kHatSidOffset, sizeof(uint64_t)) != 0) {
+		printf("synthetic-password HAT Secure User ID does not match its Gatekeeper handle\n");
+		return false;
+	}
+
+	if (android::vold::StrToHex(raw_hat, *token_hex) != android::OK) {
+		printf("failed to encode the synthetic-password Gatekeeper HAT for vold\n");
+		return false;
+	}
+	printf("Primary-user synthetic-password HAT captured and SID-validated: %zu bytes\n",
+			raw_hat.size());
+	return true;
+}
